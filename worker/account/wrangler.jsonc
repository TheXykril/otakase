{
  // Otakase accounts. Deployed by the "Deploy account Worker" workflow.
  // Repository variables, where set, replace the values below. Secrets are
  // set once with `wrangler secret put`.
  "name": "otakase-account",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "account.otakase.com", "custom_domain": true },
    { "pattern": "otakase.xyverion.com/account*", "zone_name": "xyverion.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otakase-accounts",
      "database_id": "6167c42b-df8d-4255-adc7-38491ad8e876",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "AccountHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountHub"] }],
  "vars": {
    "DISCORD_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF-FZxWsyyXf7l85",
    "BOT_URL": "https://bot.xyverion.com"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.05 }
}
