# Settings for otakase-bot. install.sh copies this to /etc/otakase-bot.env;
# edit that copy, then: sudo systemctl restart otakase-bot

# The bot's token (Discord developer portal → your app → Bot → Reset Token).
DISCORD_BOT_TOKEN=

# The server the bot runs in.
OTAKASE_GUILD_ID=1556588123561922560

# Found by name when empty: the "support" forum, the "mod-chat" channel and
# the "Contributor" role.
OTAKASE_SUPPORT_FORUM=
OTAKASE_MOD_CHANNEL=
OTAKASE_CONTRIBUTOR_ROLE=

# Client ID of a GitHub OAuth app with Device Flow enabled. /link-github is
# left out while this is empty.
OTAKASE_GITHUB_CLIENT_ID=

# Optional GitHub token, for higher API limits in /latest and /link-github.
GITHUB_TOKEN=

# Set to false to stop the welcome DM to new members.
OTAKASE_WELCOME_DM=true

# Daily "Airing today" post in the anime channel (found by name when empty),
# at this UTC hour.
OTAKASE_DAILY_AIRING=true
OTAKASE_AIRING_HOUR=6
OTAKASE_AIRING_CHANNEL=

# Default voice channel for /watchparty (the "lounge" channel when empty).
OTAKASE_LOUNGE_CHANNEL=

# Join-to-create voice channel (the one named "Create room" when empty).
OTAKASE_CREATE_ROOM=

# Text channel /suggest posts to (the "suggestions" channel when empty, else
# "ideas").
OTAKASE_SUGGESTIONS_CHANNEL=

# otakase binary /provider-status runs (install.sh and the add-on ship one).
OTAKASE_CLI=

# Ollama with a small embedding model, for answering questions the word
# patterns miss. Empty turns it off. The bot downloads the model itself.
OTAKASE_OLLAMA_URL=
OTAKASE_EMBED_MODEL=all-minilm
OTAKASE_AI_THRESHOLD=0.6
