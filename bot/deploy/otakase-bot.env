# Settings for otakase-bot. install.sh copies this to /etc/otakase-bot.env;
# edit that copy, then: sudo systemctl restart otakase-bot

# The bot's token (Discord developer portal → your app → Bot → Reset Token).
DISCORD_BOT_TOKEN=

# The server the bot runs in.
OTAKASE_GUILD_ID=1556588123561922560

# Found by name when empty: the "support" forum, the "mod-chat" channel and
# the "Contributor" role.
OTAKASE_SUPPORT_FORUM=
OTAKASE_MOD_CHANNEL=
OTAKASE_CONTRIBUTOR_ROLE=

# Client ID of a GitHub OAuth app with Device Flow enabled. /link-github is
# left out while this is empty.
OTAKASE_GITHUB_CLIENT_ID=

# Client ID and secret of an AniList app (anilist.co/settings/developer)
# whose redirect URL is https://anilist.co/api/v2/oauth/pin. With both
# /link-anilist proves the account is yours; without them members type their
# username.
OTAKASE_ANILIST_CLIENT_ID=
OTAKASE_ANILIST_SECRET=

# Role for members who linked AniList (the "AniList linked" role when empty;
# none if the server has no such role).
OTAKASE_ANILIST_ROLE=

# Helper points (thanks after a solved support post) for the Helper role.
OTAKASE_HELPER_POINTS=5

# Optional GitHub token, for higher API limits in /latest and /link-github.
GITHUB_TOKEN=

# Set to false to stop the welcome DM to new members.
OTAKASE_WELCOME_DM=true

# Daily "Airing today" post in the anime channel (found by name when empty),
# at this UTC hour.
OTAKASE_DAILY_AIRING=true
OTAKASE_AIRING_HOUR=6

# Season preview in the anime channel on the first day of each anime season
# (January, April, July, October), at the airing hour.
OTAKASE_SEASON_PREVIEW=true
OTAKASE_AIRING_CHANNEL=

# Default voice channel for /watchparty (the "lounge" channel when empty).
OTAKASE_LOUNGE_CHANNEL=

# Join-to-create voice channel (the one named "Create room" when empty).
OTAKASE_CREATE_ROOM=

# Text channel /suggest posts to (the "suggestions" channel when empty, else
# "ideas").
OTAKASE_SUGGESTIONS_CHANNEL=

# Where failing background jobs and crash restarts are reported (the
# "bot-log" channel when empty, else mod-chat).
OTAKASE_LOG_CHANNEL=

# Where deleted and edited messages are logged (the "mod-log" channel when
# empty, else mod-chat).
OTAKASE_MOD_LOG_CHANNEL=

# Warnings older than this many days stop counting toward the timeout
# (0 = they never expire).
OTAKASE_WARNING_DAYS=90

# otakase binary /provider-status runs (install.sh and the add-on ship one).
OTAKASE_CLI=

# Ollama with a small embedding model, for answering questions the word
# patterns miss. Empty turns it off. The bot downloads the model itself.
OTAKASE_OLLAMA_URL=
OTAKASE_EMBED_MODEL=all-minilm
OTAKASE_AI_THRESHOLD=0.6

# Client secret of the bot's Discord app (developer portal → OAuth2), for the
# daily puzzle Activity. Empty = /daily is played in chat only.
OTAKASE_DISCORD_CLIENT_SECRET=

# Discord URL mapping path of the watch room edge cache Worker
# (deploy/edge-worker.js), e.g. /.proxy/cdn. Empty = every viewer streams
# from the bot. Setup: wiki Developer-Discord-Bot, "Watch room edge cache".
OTAKASE_WATCH_CDN=
