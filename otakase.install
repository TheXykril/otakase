# Set up the Super+Shift+A keybinding for the user who ran the install.
#
# An install script runs as root, so $HOME is /root -- the keybinding has to be
# written as the invoking user or it lands in the wrong config and is owned by
# the wrong account. SUDO_USER names that person when pacman was reached through
# sudo, which is how it is normally reached. When it is not set -- a chroot, an
# image build, a provisioning run, pacman as root directly -- there is no user
# to act for, so this quietly does nothing and prints the command instead.
#
# Set OTAKASE_NO_KEYBIND=1 to skip it.

_otakase_as_user() {
  [ -n "${SUDO_USER:-}" ] || return 1
  [ "${SUDO_USER}" != "root" ] || return 1
  local home
  home=$(getent passwd "$SUDO_USER" | cut -d: -f6) || return 1
  [ -n "$home" ] && [ -d "$home" ] || return 1
  # Runs as them, with their HOME, so the file is written and owned correctly.
  runuser -u "$SUDO_USER" -- env HOME="$home" XDG_CONFIG_HOME="${home}/.config" \
    /usr/bin/otakase "$@" 2>&1 | sed 's/^/  /'
}

post_install() {
  cat <<'MSG'

  Otakase installed.  otk is a shorter alias for the same program.

MSG
  if [ -n "${OTAKASE_NO_KEYBIND:-}" ]; then
    echo "  Keybinding skipped (OTAKASE_NO_KEYBIND is set)."
    echo
    return
  fi
  echo "  Setting up Super+Shift+A to open the rofi menu:"
  if ! _otakase_as_user -install-keybind; then
    cat <<'MSG'
  Could not tell which user to set it up for, so nothing was changed.
  Run this yourself:

      otakase -install-keybind

MSG
    return
  fi
  echo
}

post_upgrade() {
  # Only update a binding that is already there. Re-adding one the user removed
  # on purpose would be the package arguing with them.
  [ -n "${OTAKASE_NO_KEYBIND:-}" ] && return 0
  _otakase_as_user -refresh-keybind >/dev/null 2>&1 || true
}

pre_remove() {
  # Take the keybinding out while the binary it points at still exists;
  # otherwise uninstalling leaves a key bound to a program that is gone.
  _otakase_as_user -remove-keybind >/dev/null 2>&1 || true
}
