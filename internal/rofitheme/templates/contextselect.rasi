/* Generated by curd from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette.

   This follows Omarchy's own menu language, read from the theme's shell.toml
   [menu] tokens: an opaque card on a light scrim, a hairline border on every
   side, a small radius, no prompt chip, and a selected row marked by a faint
   fill plus its own outline rather than a heavy band. Curd's menus should look
   like the desktop's menus, not like a separate application. */

configuration {
    font:            "{{ .Font }}";
    show-icons:      false;
    display-drun:    "";
}

* {
    base:         {{ .Background }};
    text:         {{ .Foreground }};
    muted:        {{ .Muted }};
    accent:       {{ .Accent }};
    edge:         {{ .CardBorder }};
    rule:         {{ .HairRule }};
    sel-fill:     {{ .SelectFill }};
    sel-edge:     {{ .SelectEdge }};
    urgent:       {{ .Red }};
    active:       {{ .Green }};
}

window {
    fullscreen:       false;
    width:            720px;
    background-color: @base;
    border:           1px;
    border-color:     @edge;
    border-radius:    8px;
    padding:          0px;
}

mainbox {
    children:         [ message, inputbar, listview ];
    background-color: transparent;
    padding:          14px;
    spacing:          8px;
}

/* The question being asked, set as a heading rather than as another row. */
message {
    enabled:          true;
    background-color: transparent;
    padding:          8px 12px;
    margin:           0px;
    border:           0px 0px 1px 0px;
    border-color:     @rule;
}

textbox {
    enabled:          true;
    background-color: transparent;
    text-color:       @text;
    font:             "{{ .HeadingFont }}";
    vertical-align:   0.5;
}

/* No prompt pill: Omarchy's menus are a bare field with placeholder text and a
   hairline beneath, and a filled chip here would read as a foreign control. */
inputbar {
    children:         [ entry ];
    background-color: transparent;
    padding:          8px 12px;
    border:           0px 0px 1px 0px;
    border-color:     @rule;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    font:              "{{ .EntryFont }}";
    placeholder:       "Filter…";
    placeholder-color: @muted;
    vertical-align:    0.5;
    cursor:            text;
}

listview {
    layout:           vertical;
    /* `lines` is the maximum; `dynamic` shrinks the window to the number of
       results, so a short list does not leave empty space below it. */
    lines:            8;
    dynamic:          true;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          0px;
    padding:          4px 0px;
    background-color: transparent;
}

element {
    padding:          7px 12px;
    border-radius:    4px;
    background-color: transparent;
    text-color:       @text;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

/* Faint fill plus an outline, and the text takes the accent -- the treatment
   Omarchy uses for a selected row. */
element selected.normal {
    background-color: @sel-fill;
    text-color:       @accent;
    border:           1px;
    border-color:     @sel-edge;
    border-radius:    4px;
}

element urgent.normal {
    text-color:       @urgent;
}

element active.normal {
    text-color:       @active;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold {{ .Accent }};
}
