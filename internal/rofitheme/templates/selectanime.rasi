/* Generated by curd from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette.

   Curd is a keyboard instrument: summoned, typed at for two seconds, dismissed.
   Its lineage is the terminal, not a launcher card, so the menu is a flat plane
   anchored by one accent rail rather than a floating rounded panel. The rail is
   the single bold element; everything else stays quiet. */

configuration {
    font:            "{{ .Font }}";
    show-icons:      false;
    display-drun:    "";
}

* {
    base:            {{ .Background }};
    rail:            {{ .Accent }};
    edge:            {{ .Border }};
    title:           {{ .Foreground }};
    title-bright:    {{ .BrightForeground }};
    meta:            {{ .Muted }};
    band:            {{ .SelectionBand }};
    urgent:          {{ .Red }};
    active:          {{ .Green }};
}

window {
    fullscreen:       false;
    width:            720px;
    background-color: @base;
    /* The rail, and nothing else: rofi allows one border colour per element, and
       an outline on all four sides is what made this read as a floating card. */
    border:           0px 0px 0px 5px;
    border-color:     @rail;
    border-radius:    4px;
    padding:          0px;
}

mainbox {
    children:         [ inputbar, listview ];
    background-color: transparent;
    padding:          0px;
    spacing:          0px;
}

/* One rule in the whole design, and it earns its place: it separates what you
   type from what you are choosing between. */
inputbar {
    children:         [ prompt, entry ];
    background-color: transparent;
    border:           0px 0px 1px 0px;
    border-color:     @edge;
    padding:          15px 18px;
    spacing:          12px;
}

prompt {
    background-color: transparent;
    text-color:       @rail;
    font:             "{{ .PromptFont }}";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @title-bright;
    font:              "{{ .EntryFont }}";
    placeholder:       "Search";
    placeholder-color: @meta;
    vertical-align:    0.5;
    cursor:            text;
}

listview {
    layout:           vertical;
    /* `lines` is the maximum; `dynamic` shrinks the window to the number of
       results, so a short list does not leave empty space below it. */
    lines:            9;
    dynamic:          true;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          0px;
    padding:          6px 0px;
    background-color: transparent;
}

/* Rows run full width to the rail. No inset pill, no per-row radius: the radius
   belongs to the window alone, so it reads as hierarchy rather than decoration. */
element {
    padding:          9px 18px;
    border-radius:    0px;
    background-color: transparent;
    text-color:       @title;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @band;
    text-color:       @title-bright;
}

element urgent.normal {
    text-color:       @urgent;
}

element active.normal {
    text-color:       @active;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold {{ .Accent }};
}
