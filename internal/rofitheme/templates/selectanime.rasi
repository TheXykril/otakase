/* Generated by curd from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette. */

configuration {
    font:            "{{ .Font }}";
    show-icons:      false;
    display-drun:    "";
}

* {
    background:      {{ .Background }};
    surface:         {{ .Surface }};
    border-color:    {{ .Border }};
    foreground:      {{ .Foreground }};
    muted:           {{ .Muted }};
    accent:          {{ .Accent }};
    selected-bg:     {{ .SelectionBackground }};
    selected-fg:     {{ .SelectionForeground }};
    urgent:          {{ .Red }};
    active:          {{ .Green }};
}

window {
    fullscreen:       false;
    width:            760px;
    background-color: @background;
    border:           1px;
    border-color:     @border-color;
    border-radius:    14px;
    padding:          0px;
}

mainbox {
    children:         [ inputbar, listview ];
    background-color: transparent;
    padding:          14px;
    spacing:          12px;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @surface;
    border:           1px;
    border-color:     @border-color;
    border-radius:    10px;
    padding:          4px;
    spacing:          8px;
}

prompt {
    background-color: @accent;
    text-color:       {{ .OnAccent }};
    padding:          8px 14px;
    border-radius:    7px;
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @foreground;
    placeholder:       "Search...";
    placeholder-color: @muted;
    padding:           8px 6px;
    vertical-align:    0.5;
    cursor:            text;
}

listview {
    layout:           vertical;
    lines:            10;
    scrollbar:        false;
    spacing:          2px;
    background-color: transparent;
}

element {
    padding:          9px 12px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
}

/* A left accent bar marks the cursor row, so it stays readable even on themes
   whose selection colour sits close to the background. */
element selected.normal {
    background-color: @selected-bg;
    text-color:       @selected-fg;
    border:           0px 0px 0px 3px;
    border-color:     @accent;
}

element alternate.normal {
    background-color: transparent;
}

element urgent.normal {
    text-color:       @urgent;
}

element active.normal {
    text-color:       @active;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold {{ .Accent }};
}
