/* Generated by otakase from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette.

   This follows Omarchy's own menu language, read from the theme's shell.toml
   [menu] tokens: an opaque card on a light scrim, a hairline border on every
   side, a small radius, no prompt chip, and a selected row marked by a faint
   fill plus its own outline rather than a heavy band. Curd's menus should look
   like the desktop's menus, not like a separate application. */

configuration {
    font:            "{{ .Font }}";
    show-icons:      false;
}

* {
    base:         {{ .Background }};
    text:         {{ .Foreground }};
    muted:        {{ .Muted }};
    accent:       {{ .Accent }};
    edge:         {{ .CardBorder }};
    rule:         {{ .HairRule }};
    sel-fill:     {{ .SelectFill }};
    sel-edge:     {{ .SelectEdge }};
    urgent:       {{ .Red }};
    active:       {{ .Green }};
}

window {
    fullscreen:       false;
    width:            640px;
    background-color: @base;
    border:           1px;
    border-color:     @edge;
    border-radius:    8px;
    padding:          0px;
}

mainbox {
    children:         [ message, inputbar ];
    background-color: transparent;
    padding:          14px;
    spacing:          8px;
}

message {
    background-color: transparent;
    padding:          8px 12px;
    margin:           0px;
    border:           0px 0px 1px 0px;
    border-color:     @rule;
}

textbox {
    background-color: transparent;
    text-color:       @text;
    font:             "{{ .HeadingFont }}";
    padding:          0px;
}

/* No prompt pill: Omarchy's menus are a bare field with placeholder text and a
   hairline beneath, and a filled chip here would read as a foreign control. */
inputbar {
    children:         [ entry ];
    background-color: transparent;
    padding:          8px 12px;
    border:           0px 0px 1px 0px;
    border-color:     @rule;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    font:              "{{ .EntryFont }}";
    placeholder:       "Type to search…";
    placeholder-color: @muted;
    vertical-align:    0.5;
    cursor:            text;
}
