/* Generated by curd from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette. */

configuration {
    font:        "{{ .Font }}";
    show-icons:  false;
}

* {
    base:         {{ .Background }};
    rail:         {{ .Accent }};
    edge:         {{ .Border }};
    title:        {{ .Foreground }};
    title-bright: {{ .BrightForeground }};
    meta:         {{ .Muted }};
}

window {
    fullscreen:       false;
    width:            620px;
    background-color: @base;
    /* The rail, and nothing else: rofi allows one border colour per element, and
       an outline on all four sides is what made this read as a floating card. */
    border:           0px 0px 0px 5px;
    border-color:     @rail;
    border-radius:    4px;
    padding:          0px;
}

mainbox {
    children:         [ message, inputbar ];
    background-color: transparent;
    padding:          0px;
    spacing:          0px;
}

/* The question is the heading here, so it carries the weight and the rule sits
   beneath it -- the same rule the list menu uses under its input. */
message {
    background-color: transparent;
    border:           0px 0px 1px 0px;
    border-color:     @edge;
    padding:          18px;
    margin:           0px;
}

textbox {
    background-color: transparent;
    text-color:       @title-bright;
    font:             "{{ .HeadingFont }}";
    padding:          0px;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: transparent;
    padding:          15px 18px;
    spacing:          12px;
}

prompt {
    background-color: transparent;
    text-color:       @rail;
    font:             "{{ .PromptFont }}";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @title-bright;
    font:              "{{ .EntryFont }}";
    placeholder:       "Type to search";
    placeholder-color: @meta;
    vertical-align:    0.5;
    cursor:            text;
}
