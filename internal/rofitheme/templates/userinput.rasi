/* Generated by curd from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette. */

configuration {
    font:        "{{ .Font }}";
    show-icons:  false;
}

* {
    background:   {{ .Background }};
    surface:      {{ .Surface }};
    border-color: {{ .Border }};
    foreground:   {{ .Foreground }};
    muted:        {{ .Muted }};
    accent:       {{ .Accent }};
}

window {
    fullscreen:       false;
    width:            640px;
    background-color: @background;
    border:           1px;
    border-color:     @border-color;
    border-radius:    14px;
    padding:          0px;
}

mainbox {
    children:         [ message, inputbar ];
    background-color: transparent;
    padding:          22px;
    spacing:          16px;
}

message {
    background-color: transparent;
    padding:          0px;
    margin:           0px;
    border:           0px;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
    font:             "{{ .HeadingFont }}";
    padding:          0px;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @surface;
    border:           1px;
    border-color:     @border-color;
    border-radius:    10px;
    padding:          4px;
    spacing:          8px;
}

prompt {
    background-color: @accent;
    text-color:       {{ .OnAccent }};
    padding:          8px 14px;
    border-radius:    7px;
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @foreground;
    placeholder:       "Type here...";
    placeholder-color: @muted;
    padding:           8px 6px;
    vertical-align:    0.5;
    cursor:            text;
}
