/* Generated by curd from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette.

   The poster wall. Cover art is the content here, so the chrome gets out of its
   way: no card backgrounds, no borders around every tile. Selection is the only
   thing drawn, and it is drawn decisively. */

configuration {
    font:        "{{ .Font }}";
    show-icons:  true;
}

* {
    base:         {{ .Background }};
    scrim:        {{ .Scrim }};
    rail:         {{ .Accent }};
    edge:         {{ .Border }};
    title:        {{ .Foreground }};
    title-bright: {{ .BrightForeground }};
    meta:         {{ .Muted }};
    band:         {{ .SelectionBand }};
}

window {
    fullscreen:       true;
    width:            100%;
    height:           100%;
    transparency:     "real";
    background-color: @scrim;
    border:           0px;
    padding:          0px;
}

mainbox {
    children:         [ inputbar, listview ];
    background-color: transparent;
    padding:          40px 48px 32px 48px;
    spacing:          32px;
}

/* Left-aligned with the grid below it rather than floated in the centre: the
   eye starts at the same x as the first poster. */
inputbar {
    children:         [ prompt, entry ];
    background-color: transparent;
    border:           0px 0px 1px 0px;
    border-color:     @edge;
    padding:          0px 4px 16px 4px;
    spacing:          12px;
}

prompt {
    background-color: transparent;
    text-color:       @rail;
    font:             "{{ .TitleFont }}";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @title-bright;
    font:              "{{ .TitleFont }}";
    placeholder:       "Search";
    placeholder-color: @meta;
    vertical-align:    0.5;
    cursor:            text;
}

listview {
    layout:           vertical;
    /* rofi clamps this grid to four columns whatever is asked for, so four is
       what is declared: a number the theme cannot deliver is just a lie in the
       source. It also fills column-major, which is rofi's own behaviour and not
       something a theme can change. */
    columns:          4;
    lines:            3;
    dynamic:          false;
    scrollbar:        false;
    padding:          4px;
    spacing:          24px;
    background-color: transparent;
}

element {
    children:         [ element-box ];
    orientation:      vertical;
    padding:          12px;
    border:           0px;
    border-radius:    6px;
    background-color: transparent;
    cursor:           pointer;
}

/* On a wall of covers a text-colour change is invisible, so the selected tile
   gets a filled band behind it -- the same band the list menu uses for its
   cursor row, so the two menus read as one system. */
element selected {
    background-color: @band;
}

element-box {
    children:         [ element-icon, element-text ];
    orientation:      vertical;
    expand:           false;
    spacing:          8px;
    background-color: transparent;
    cursor:           pointer;
}

element-icon {
    size:             200px;
    padding:          0px;
    margin:           0px;
    border-radius:    3px;
    cursor:           inherit;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           inherit;
    text-color:       @title;
    background-color: transparent;
    highlight:        bold {{ .Accent }};
}

element-text selected {
    text-color:       @title-bright;
}
