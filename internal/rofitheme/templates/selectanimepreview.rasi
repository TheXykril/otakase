/* Generated by otakase from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette.

   The poster wall, in Omarchy's menu language. It is a card on a scrim rather
   than a fullscreen surface: Omarchy's scrim is deliberately light (0.5), which
   works because its menus are opaque cards sitting on top of it. Rendering the
   covers straight onto that scrim instead let the wallpaper compete with the
   artwork, so the grid gets a card like every other menu. */

configuration {
    font:        "{{ .Font }}";
    show-icons:  true;
}

* {
    base:     {{ .Background }};
    scrim:    {{ .Scrim }};
    text:     {{ .Foreground }};
    muted:    {{ .Muted }};
    accent:   {{ .Accent }};
    edge:     {{ .CardBorder }};
    rule:     {{ .HairRule }};
    sel-fill: {{ .SelectFill }};
    sel-edge: {{ .SelectEdge }};
}

window {
    fullscreen:       false;
    width:            1100px;
    background-color: @base;
    border:           1px;
    border-color:     @edge;
    border-radius:    8px;
    padding:          0px;
}

mainbox {
    children:         [ inputbar, listview ];
    background-color: transparent;
    padding:          18px;
    spacing:          14px;
}

inputbar {
    children:         [ entry ];
    background-color: transparent;
    padding:          8px 12px;
    border:           0px 0px 1px 0px;
    border-color:     @rule;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    font:              "{{ .EntryFont }}";
    placeholder:       "Search anime…";
    placeholder-color: @muted;
    vertical-align:    0.5;
    cursor:            text;
}

/* Three columns. The label under each cover is budgeted against this width in
   Go (see GridLabelCapacity): the title is truncated so the episode counts
   always survive, because the cover already identifies the show and the counts
   are the part you cannot see from the artwork. Changing the column count or
   the card width means re-measuring that budget. */
listview {
    layout:           vertical;
    columns:          3;
    lines:            2;
    dynamic:          false;
    scrollbar:        false;
    padding:          4px;
    spacing:          24px;
    background-color: transparent;
}

element {
    children:         [ element-box ];
    orientation:      vertical;
    padding:          12px;
    border:           1px;
    border-color:     transparent;
    border-radius:    8px;
    background-color: transparent;
    cursor:           pointer;
}

element selected {
    background-color: @sel-fill;
    border-color:     @sel-edge;
}

element-box {
    children:         [ element-icon, element-text ];
    orientation:      vertical;
    expand:           false;
    spacing:          8px;
    background-color: transparent;
    cursor:           pointer;
}

element-icon {
    size:             240px;
    padding:          0px;
    margin:           0px;
    border-radius:    4px;
    cursor:           inherit;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           inherit;
    text-color:       @text;
    background-color: transparent;
    highlight:        bold {{ .Accent }};
}

element-text selected {
    text-color:       @accent;
}
