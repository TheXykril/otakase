/* Generated by curd from the active colour theme. Edits are overwritten.
   Set Theme=builtin in curd.conf to keep curd's own palette. */

configuration {
    font:        "{{ .Font }}";
    show-icons:  true;
}

* {
    background:       {{ .Background }};
    background-scrim: {{ .Scrim }};
    surface:          {{ .Surface }};
    border-color:     {{ .Border }};
    foreground:       {{ .Foreground }};
    muted:            {{ .Muted }};
    accent:           {{ .Accent }};
    selected-bg:      {{ .SelectionBackground }};
    selected-fg:      {{ .SelectionForeground }};
}

window {
    fullscreen:       true;
    width:            100%;
    height:           100%;
    transparency:     "real";
    background-color: @background-scrim;
    border:           0px;
    padding:          0px;
}

mainbox {
    children:         [ inputbar-box, listview ];
    background-color: transparent;
    padding:          32px 40px 24px 40px;
    spacing:          24px;
}

/* The search field is centred above the poster grid rather than pinned to the
   left edge, so the eye lands on it first on a fullscreen window. */
inputbar-box {
    children:         [ dummy, inputbar, dummy ];
    orientation:      horizontal;
    expand:           false;
    background-color: transparent;
}

dummy {
    background-color: transparent;
}

inputbar {
    children:         [ textbox-prompt, entry ];
    expand:           false;
    background-color: @surface;
    border:           1px;
    border-color:     @border-color;
    border-radius:    12px;
    padding:          5px;
    spacing:          10px;
}

textbox-prompt {
    background-color: @accent;
    text-color:       {{ .OnAccent }};
    padding:          9px 16px;
    border-radius:    8px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    expand:           false;
}

entry {
    expand:            false;
    width:             420px;
    padding:           9px 8px;
    background-color:  transparent;
    text-color:        @foreground;
    placeholder:       "Search...";
    placeholder-color: @muted;
    horizontal-align:  0;
    vertical-align:    0.5;
    cursor:            text;
}

listview {
    layout:           vertical;
    orientation:      horizontal;
    columns:          6;
    dynamic:          true;
    scrollbar:        false;
    padding:          8px;
    spacing:          18px;
    background-color: transparent;
}

element {
    children:         [ element-box ];
    orientation:      vertical;
    padding:          8px;
    border:           1px;
    border-color:     transparent;
    border-radius:    14px;
    background-color: transparent;
    cursor:           pointer;
}

/* Selection is drawn as a filled card with an accent outline: on a poster wall a
   text-colour change alone is almost invisible. */
element selected {
    background-color: @selected-bg;
    border-color:     @accent;
}

element-box {
    children:         [ element-icon, element-text ];
    orientation:      vertical;
    expand:           false;
    spacing:          8px;
    background-color: transparent;
    cursor:           pointer;
}

element-icon {
    size:             180px;
    padding:          0px;
    margin:           0px;
    border-radius:    10px;
    cursor:           inherit;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           inherit;
    text-color:       @foreground;
    background-color: transparent;
    highlight:        bold {{ .Accent }};
}

element-text selected {
    text-color:       @selected-fg;
}
