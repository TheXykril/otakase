<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/build-tpk.sh sets version and api-version for each TV group. -->
<manifest package="com.xyverion.otakase" version="1.0.0" api-version="6.0" xmlns="http://tizen.org/ns/packages">
    <profile name="tv-samsung"/>
    <ui-application appid="com.xyverion.otakase" exec="Runner.dll" type="dotnet" multiple="false" nodisplay="false" taskmanage="true">
        <label>Otakase</label>
        <icon>ic_launcher.png</icon>
        <metadata key="http://tizen.org/metadata/prefer_dotnet_aot" value="true"/>
        <metadata key="http://tizen.org/metadata/prefer_nuget_cache" value="true"/>
    </ui-application>
    <privileges>
        <privilege>http://tizen.org/privilege/internet</privilege>
        <privilege>http://tizen.org/privilege/network.get</privilege>
        <privilege>http://tizen.org/privilege/mediastorage</privilege>
        <privilege>http://tizen.org/privilege/externalstorage</privilege>
        <privilege>http://developer.samsung.com/privilege/drmplay</privilege>
    </privileges>
    <feature name="http://tizen.org/feature/screen.size.all"/>
</manifest>
