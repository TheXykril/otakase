<Project Sdk="Tizen.NET.Sdk/1.1.7">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen80</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TizenCoreEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);TIZEN_CORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(FlutterEmbeddingPath)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Go core, built by scripts/build-tpk.sh. -->
    <TizenTpkUserIncludeFiles Include="lib\*.so">
      <TizenTpkSubDir>lib</TizenTpkSubDir>
    </TizenTpkUserIncludeFiles>
    <!-- Which shell an update must match; written by scripts/build-tpk.sh. -->
    <TizenTpkUserIncludeFiles Include="shell-id" Condition="Exists('shell-id')">
      <TizenTpkSubDir>res</TizenTpkSubDir>
    </TizenTpkUserIncludeFiles>
    <FlutterEphemeral Include="flutter\ephemeral\**\*" />
    <TizenTpkUserIncludeFiles Include="@(FlutterEphemeral)">
      <TizenTpkSubDir>%(RecursiveDir)</TizenTpkSubDir>
    </TizenTpkUserIncludeFiles>
  </ItemGroup>

</Project>
